# WorkOS (Next.js .env.local)
WORKOS_CLIENT_ID=client_REPLACE_ME_WITH_YOUR_OWN
WORKOS_API_KEY=sk_test_REPLACE_ME
WORKOS_WEBHOOK_SECRET=whsec_REPLACE_ME
WORKOS_COOKIE_PASSWORD=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Zero-signup local auth is OFF by default and cannot be enabled in production.
# Do not set this file to true. Opt in for one development command instead:
#   LOCAL_AUTH=true npm run dev
# That command supplies local-only placeholder WorkOS settings and generates an
# ignored private key in .local-auth/. No WorkOS account or network call is used.
# LOCAL_AUTH=false

# IMPORTANT: the Convex backend reads WORKOS_CLIENT_ID, WORKOS_API_KEY and
# WORKOS_WEBHOOK_SECRET from the CONVEX runtime (not .env.local). The backend
# refuses to boot until all three are set there:
#   npx convex env set WORKOS_CLIENT_ID     client_...
#   npx convex env set WORKOS_API_KEY       sk_test_...
#   npx convex env set WORKOS_WEBHOOK_SECRET whsec_...
#
# Demo provisioning is disabled unless explicitly enabled in an isolated Convex
# deployment. Set five distinct generated values in the Convex runtime; never
# commit them or use either Super Admin fixture as a public account:
#   DEMO_SEEDING_ENABLED=false
#   DEMO_ADMIN_PASSWORD=<set in Convex only>
#   DEMO_GUARD_PASSWORD=<set in Convex only>
#   DEMO_OPS_PASSWORD=<set in Convex only>
#   DEMO_TENANT_PASSWORD=<set in Convex only>
#   DEMO_OWNER_PASSWORD=<set in Convex only>

# Convex (Next.js .env.local — local dev uses anonymous deployment)
CONVEX_DEPLOYMENT=anonymous:anonymous-rental-platform-os-1
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Shared secret for Next.js → Convex HTTP endpoint auth (optional in dev, required in prod)
# Generate with: openssl rand -hex 32
# Must also be set in Convex env vars: npx convex env set INTERNAL_API_SECRET <value>
INTERNAL_API_SECRET=

# OpenAI (optional — only required if voice transcription is enabled)
OPENAI_API_KEY=sk-REPLACE_ME

# ──────────────────────────────────────────────────
# Dev Test Accounts (seeded in Convex; WorkOS provisioning is only needed when
# LOCAL_AUTH is off). Use these on /dev/login in development mode.
# ──────────────────────────────────────────────────
#
# ADMIN — Demo Admin (Super Admin, all permissions)
#   Email:    admin@example.com
#   Password: configure outside the repository
#   Login at: http://localhost:3000/dev/login → "Test Admin" button
#   Opens:    /admin/dashboard
#
# ADMIN — Agent Bot (Super Admin, all permissions)
#   Email:    agent@example.com
#   Password: configure outside the repository
#   Login at: http://localhost:3000/dev/login → manual form
#   Opens:    /admin/dashboard
#
# GUARD — Test Guard
#   Email:    9999999999@guards.local
#   Password: configure outside the repository
#   Login at: http://localhost:3000/dev/login → "Test Guard" button
#   Opens:    /guard/dashboard
