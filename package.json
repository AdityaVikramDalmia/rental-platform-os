{
  "name": "rental-platform-os",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently --names backend,frontend --prefix-colors blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:force": "npm run kill-ports && npm run dev",
    "dev:frontend": "node scripts/run-with-local-auth.mjs next dev -p 3000",
    "dev:backend": "node scripts/run-with-local-auth.mjs npx convex dev",
    "kill-ports": "lsof -ti:3000,3210,6790 | xargs kill -9 2>/dev/null; sleep 1; echo 'Ports 3000, 3210, 6790 cleared'",
    "build": "next build",
    "start": "next start",
    "preview": "npm run build && next start -p 3000",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/run-with-local-auth.mjs npx convex run seed:init",
    "seed:dev": "npx convex run actions/workos:ensureDevWorkosUsers",
    "smoke:admin-login": "node scripts/admin-dev-login-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "dev:setup": "npm run dev:force & sleep 5 && npm run seed && echo 'Dev environment ready at http://localhost:3000'"
  },
  "dependencies": {
    "@convex-dev/aggregate": "^0.2.1",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/workos-authkit": "^0.1.6",
    "@hookform/resolvers": "^5.2.2",
    "@serwist/next": "^9.5.6",
    "@workos-inc/authkit-nextjs": "^2.14.0",
    "@workos-inc/node": "^8.5.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.31.7",
    "convex-helpers": "^0.1.112",
    "date-fns": "^4.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.564.0",
    "motion": "^12.34.2",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "openai": "^6.22.0",
    "radix-ui": "^1.4.3",
    "razorpay": "^2.9.6",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "serwist": "^9.5.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.41",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.8.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
